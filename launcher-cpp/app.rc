#include <windows.h>
IDI_ICON1 ICON "icon.ico"
LOGO_JPG RCDATA "logo.jpg"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Etherial"
            VALUE "FileDescription", "Etherial Launcher"
            VALUE "FileVersion", "1.0"
            VALUE "InternalName", "EtherealLauncher"
            VALUE "OriginalFilename", "EtherealLauncher.exe"
            VALUE "ProductName", "Etherial Client"
            VALUE "ProductVersion", "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
